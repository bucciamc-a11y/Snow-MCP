# Non-secret settings. Installed to /etc/servicenow-mcp/config.env (root:root 0644).
# scripts/configure.sh writes this file for you; edit by hand only if you prefer.

# ServiceNow instance base URL: https only, host must end in .service-now.com or
# .servicenowservices.com unless SERVICENOW_ALLOW_CUSTOM_DOMAIN=true.
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_ALLOW_CUSTOM_DOMAIN=false

# DNS name Hermes uses to reach this server (used for Host/Origin validation).
MCP_PUBLIC_HOSTNAME=mcp.example.com

# --- TLS: choose ONE ---
# (a) Recommended: plain HTTP only on loopback or a private address (e.g. the Docker bridge
#     gateway 172.17.0.1); Traefik terminates TLS. Wildcard/public binds are refused.
MCP_BIND_HOST=127.0.0.1
MCP_BIND_PORT=8765
MCP_BEHIND_TLS_PROXY=true
# (b) Native TLS (then MCP_BEHIND_TLS_PROXY may be false and MCP_BIND_HOST may be public).
#     The files must be readable by the 'servicenow-mcp' user.
# MCP_TLS_CERT_FILE=/etc/servicenow-mcp/tls/fullchain.pem
# MCP_TLS_KEY_FILE=/etc/servicenow-mcp/tls/privkey.pem

# --- limits ---
MCP_REQUEST_TIMEOUT=15
MCP_MAX_PAGE_SIZE=50
MCP_RATE_LIMIT_PER_MINUTE=60
MCP_MAX_TEXT_CHARS=4000
MCP_LOG_LEVEL=INFO


# --- optional capabilities: ALL OFF by default; the setup script asks about each ---
# NOTE: keep comments on their own lines; systemd EnvironmentFile does not allow trailing comments.
# create_incident, update_incident, resolve_incident
MCP_ENABLE_INCIDENT_WRITES=false
# assign_incident (requires MCP_ASSIGNMENT_GROUPS)
MCP_ENABLE_INCIDENT_ASSIGNMENT=false
# Allowed teams, e.g. "Network Ops=<32-hex sys_id>;Service Desk=<32-hex sys_id>"
MCP_ASSIGNMENT_GROUPS=""
# approve_change_request (approvals pending for the integration user only)
MCP_ENABLE_CHANGE_APPROVAL=false
MCP_APPROVAL_ALLOWED_TYPES=standard,normal
# list_oncall_rotas, get_oncall_roster, whois_oncall
MCP_ENABLE_ONCALL_READ=false
# add_oncall_member, update_oncall_member
MCP_ENABLE_ONCALL_WRITES=false
# search_problems, get_problem (needs read access to the problem table)
MCP_ENABLE_PROBLEM_READ=false
# create_problem, update_problem, resolve_problem, link_incident_to_problem (implies the two read tools;
# problem teams come from MCP_ASSIGNMENT_GROUPS above)
MCP_ENABLE_PROBLEM_WRITES=false
# Raw ServiceNow state values for problems. These defaults are the 101-107 model of current releases;
# older instances differ (check a problem list with the State column showing values), so override as needed.
MCP_PROBLEM_STATES="new=101;assess=102;root_cause_analysis=103;fix_in_progress=104;resolved=106;closed=107"
# search_change_requests (needs read access to the change_request table)
MCP_ENABLE_CHANGE_READ=false
# create_change_request, update_change_request, transition_change_request, close_change_request,
# cancel_change_request (implies the read tool; change teams come from MCP_ASSIGNMENT_GROUPS above)
MCP_ENABLE_CHANGE_WRITES=false
# Change types an agent may create (emergency is excluded unless you list it).
MCP_CHANGE_CREATE_TYPES="normal,standard"
# Raw ServiceNow state values for change phases. These defaults are the model-based lifecycle of current
# releases (new=-5 ... review=0, closed=3, canceled=4); override as needed for your instance.
MCP_CHANGE_STATES="new=-5;assess=-4;authorize=-3;scheduled=-2;implement=-1;review=0;closed=3;canceled=4"
# search_catalog_items, get_catalog_item, get_catalog_options (needs read access to the catalog tables)
MCP_ENABLE_CATALOG_READ=false
# create_catalog_item, create_record_producer, add_catalog_variables (implies the read tools); items are always created inactive
MCP_ENABLE_CATALOG_WRITES=false
# Tables a record producer may create records in (comma list)
MCP_PRODUCER_TARGET_TABLES=incident
MCP_WRITE_RATE_LIMIT_PER_MINUTE=20