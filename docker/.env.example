# Non-secret compose settings (placeholders only). docker-setup.sh generates docker/.env.
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_ALLOW_CUSTOM_DOMAIN=false
MCP_PUBLIC_HOSTNAME=mcp.example.com
MCP_LOG_LEVEL=INFO
# Name of the existing docker network Traefik is attached to.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
# Name of the certificate resolver in Traefik's static configuration.
TRAEFIK_CERTRESOLVER=letsencrypt

# --- optional capabilities: ALL OFF by default; the setup script asks about each ---
# NOTE: keep comments on their own lines; systemd EnvironmentFile does not allow trailing comments.
# create_incident, update_incident, resolve_incident
MCP_ENABLE_INCIDENT_WRITES=false
# assign_incident (requires MCP_ASSIGNMENT_GROUPS)
MCP_ENABLE_INCIDENT_ASSIGNMENT=false
# Allowed teams, e.g. "Network Ops=<32-hex sys_id>;Service Desk=<32-hex sys_id>"
MCP_ASSIGNMENT_GROUPS=""
# approve_change_request (approvals pending for the integration user only)
MCP_ENABLE_CHANGE_APPROVAL=false
MCP_APPROVAL_ALLOWED_TYPES=standard,normal
# list_oncall_rotas, get_oncall_roster, whois_oncall
MCP_ENABLE_ONCALL_READ=false
# add_oncall_member, update_oncall_member
MCP_ENABLE_ONCALL_WRITES=false
# search_problems, get_problem (needs read access to the problem table)
MCP_ENABLE_PROBLEM_READ=false
# create_problem, update_problem, resolve_problem, link_incident_to_problem (implies the two read tools;
# problem teams come from MCP_ASSIGNMENT_GROUPS above)
MCP_ENABLE_PROBLEM_WRITES=false
# Raw ServiceNow state values for problems. These defaults are the 101-107 model of current releases;
# older instances differ (check a problem list with the State column showing values), so override as needed.
MCP_PROBLEM_STATES="new=101;assess=102;root_cause_analysis=103;fix_in_progress=104;resolved=106;closed=107"
MCP_WRITE_RATE_LIMIT_PER_MINUTE=20